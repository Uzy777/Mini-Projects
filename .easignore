# Keep the repository-root .gitignore rules because .easignore takes precedence.
testing/
__pycache__
venv/
.python-version
.vscode
notes.txt

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# JavaScript dependencies and generated output
node_modules
dist
dist-ssr
*.local

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# EAS only needs the No More Later app from this multi-project repository.
/.git/
/.agents/
/.codex/
/.vscode/
/Python/
/Scripts/
/React/adventure-story/
/React/country-explorer/
/React/pig-dice-game/
/React/typing-game/
/React/utility-deck/
/React/wallpaper-dashboard/

