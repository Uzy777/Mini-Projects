{
    "cli": {
        "version": ">= 22.2.0",
        "appVersionSource": "remote"
    },
    "build": {
        "development": {
            "developmentClient": true,
            "distribution": "internal",
            "channel": "development"
        },
        "preview": {
            "distribution": "internal",
            "environment": "preview",
            "channel": "preview",
            "env": {
                "EXPO_PUBLIC_ENABLE_PREMIUM_TEST_CONTROLS": "true"
            },
            "android": {
                "buildType": "apk"
            }
        },
        "production": {
            "autoIncrement": true,
            "channel": "production"
        }
    },
    "submit": {
        "production": {}
    }
}
