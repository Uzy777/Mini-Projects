# Preserve every rule from this app's .gitignore because .easignore takes precedence.

# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native folders generated by Expo prebuild
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision
/ios
/android

# Metro
.metro-health-check*

# Debug logs
npm-debug.*
yarn-debug.*
yarn-error.*
*.log

# Editor and operating-system files
.DS_Store
.idea/
.vscode/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.pem

# Local environment and secret files
.env
.env.*
!.env.example

# TypeScript output
*.tsbuildinfo

# Local example, reports, caches and temporary output
app-example/
coverage/
.nyc_output/
test-results/
playwright-report/
.cache/
.turbo/
*.tmp
*.temp
*.bak
*.backup
*~

# Local native build artifacts
*.apk
*.aab
*.ipa
